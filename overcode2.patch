+def test_database_path_honours_data_dir(monkeypatch, tmp_path):
+    monkeypatch.delenv("OPENCODE_DB", raising=False)
+    monkeypatch.setenv("OPENCODE_DATA_DIR", str(tmp_path))
+    assert database_path() == tmp_path / "opencode.db"
+
